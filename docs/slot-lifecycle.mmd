%% Slot lifecycle: backend pick, load, prefix cache, prewarm, idle unload.
%% Drawn 2026-08-19 from nollama.py @ 85e796f.
%% Updated 2026-09-01: --gpu-large-alloc manual override of the alloc gate (issue #24).
%% Updated 2026-09-13: KV pool auto-size is device-typed (GPU takes the larger of
%%   headroom-reserve and headroom/3; CPU keeps the fraction) and rounds; load
%%   progress heartbeat added around the build.
%% Updated 2026-09-13: dGPU keepalive against WDDM idle eviction.
%% Updated 2026-09-13: the watchdog's ready-only guard is load-bearing (issue #38).
%% Updated 2026-09-17: EmbedSlot — a non-generative slot with its own load path
%%   and no idle unload (issue #43).
%% Legend: solid = normal path, dashed = failure/fallback/degraded,
%%         ALL-CAPS nodes = prose annotations.
%% Palette: route (blue) = decisions, gen (green) = live pipeline states,
%%          client (yellow) = external effects, warn (orange) = annotations.
%% covers: nollama.py:_gpu_keepalive,_keepalive_eligible,_LoadProgress,_load_time_key,_remembered_load_time,_record_load_time,main,needs_optimum,is_vlm,_verify_weights_integrity,_resolve_kv_pool,_preflight_memory,_preflight_verdict,_largest_weight_tensor_bytes,_gpu_large_alloc_props,npu_arch_warning,load,warmup,_prewarm_slot,_idle_watchdog,ensure_loaded,unload,_load_in_background
%% (_slot_class is nested inside main and invisible to the checker's AST scan
%%  — its box below is covered via main.)
flowchart TB
  main["main<br/>ports, devices, flag policy"] --> _slot_class
  _slot_class{"_slot_class<br/>--backend / NEEDS_OPTIMUM"}
  _slot_class -->|"genai (default)"| load
  _slot_class -.->|"nemotron_h or --backend optimum"| optimum_load["OptimumSlot.load<br/>python runtime, no prefix cache,<br/>text-only even for VLM-shaped exports"]

  main --> _load_in_background["_load_in_background<br/>one thread per slot; prints the ready
  banner once when ALL slots settled"]
  _load_in_background --> load

  load["DeviceSlot.load"] --> _verify_weights_integrity
  _verify_weights_integrity{"_verify_weights_integrity<br/>max(offset+size) per IR vs .bin bytes"}
  _verify_weights_integrity -.->|"truncated / missing .bin"| loaderr["RuntimeError, plain-English;<br/>'another process using the NPU?'<br/>hint SUPPRESSED for this class"]
  _verify_weights_integrity --> _resolve_kv_pool

  _resolve_kv_pool["_resolve_kv_pool<br/>pin via --cache-size-gb, else auto from<br/>headroom = budget - weights*1.1.<br/>GPU: max(headroom - 2 GB, headroom/3)<br/>CPU: headroom/3 ONLY<br/>ROUNDED, floor 2 GB, cap 64k tokens"]
  _resolve_kv_pool --> _preflight_memory["_preflight_memory<br/>never blocks: _preflight_verdict says<br/>fits (silent) / tight (info, within the<br/>estimate's own 5% slack) / over (WARNING,<br/>hint typed iGPU vs dGPU); logs pool
  token capacity"]
  _preflight_memory --> _LoadProgress

  _LoadProgress["_LoadProgress.start<br/>daemon ticker, gaps 5/10/15/30s;<br/>_remembered_load_time yields a %,<br/>absent one it counts elapsed and says so.<br/>Clock starts HERE, after integrity+preflight"]
  _LoadProgress --> alloc_gate

  alloc_gate{"GPU slot:<br/>--gpu-large-alloc given?"}
  alloc_gate -.->|"yes: force the property,<br/>skip the inspection entirely"| pipebuild
  alloc_gate -->|"no (the default)"| _gpu_large_alloc_props

  _gpu_large_alloc_props{"_gpu_large_alloc_props<br/>GPU only: _largest_weight_tensor_bytes<br/>&gt; this device's per-alloc cap?"}
  _gpu_large_alloc_props -.->|"yes: add<br/>GPU_ENABLE_LARGE_ALLOCATIONS"| pipebuild
  _gpu_large_alloc_props -->|"no (the common case)"| pipebuild

  pipebuild{"pipeline build<br/>plugin_props = OFFLOAD_RATIO +<br/>large-allocation hint"}
  pipebuild -->|NPU| npu_arch{"npu_arch_warning<br/>config.json model_type x<br/>DEVICE_ARCHITECTURE"}
  npu_arch -->|"not a known-bad pairing"| npu_pipe
  npu_arch -.->|"known bad on this NPU generation"| npu_warn["WARNING to stdout;<br/>load CONTINUES - never refuses"]
  npu_warn --> npu_pipe
  npu_pipe["LLMPipeline MAX_PROMPT_LEN=4096<br/>plain; no CB path on NPU"]
  pipebuild -->|"GPU/CPU + prompt cache"| cb_pipe["LLMPipeline / VLMPipeline with<br/>scheduler_config(enable_prefix_caching,<br/>cache_size=kv_pool_gb)"]
  pipebuild -->|--no-prompt-cache| plain_pipe["plain pipeline"]
  cb_pipe -.->|"runtime rejects the property"| cb_fallback["plain pipeline; kv_pool_gb=0<br/>so /health is honest and<br/>prewarm skips this slot"]

  cb_pipe --> _LoadDone
  _LoadDone["_LoadProgress.done<br/>stops ticker, _record_load_time writes<br/>.load-times.json for the NEXT run's estimate.<br/>NOT called on a raise - a failed duration<br/>would poison the estimate"]
  _LoadDone --> warmup["warmup<br/>5-token generate; ready or error"]
  npu_pipe --> _LoadDone
  plain_pipe --> _LoadDone
  cb_fallback --> _LoadDone
  optimum_load --> warmup

  warmup --> _prewarm_slot{"_prewarm_slot<br/>PREWARM_FILE + live kv pool<br/>AND slot is PREWARM_SLOT?"}
  _prewarm_slot -->|"yes: prefill saved prompt<br/>(VLM replays via parse_messages<br/>so the token prefix matches)"| ready["ready<br/>(first real turn = cache hit)"]
  _prewarm_slot -.->|"no pool / no file /<br/>not the prewarm slot"| ready

  _load_in_background -.->|"--embed-model-dir"| embed_load
  embed_load["EmbedSlot.load<br/>TextEmbeddingPipeline, MEAN + L2,<br/>no KV pool, no preflight, no prefix cache"]
  embed_load --> embed_warm["EmbedSlot.warmup<br/>embed one string; learns dims"]
  embed_warm --> embed_ready["ready<br/>serves /v1/embeddings + /api/embed<br/>embed() slices the request (--embed-batch-size),<br/>lock per slice, progress logged"]
  embed_ready -.-> EMBEDSLOT

  EMBEDSLOT["AN EMBEDDING SLOT IS NOT A DeviceSlot AND HAS NO last_used,
  which is exactly what exempts it from _idle_watchdog above (that loop
  skips any slot without the attribute - the same mechanism WhisperSlot
  relies on). Deliberate: the model is a few hundred MB, so unloading it
  reclaims nothing worth a stalled RAG batch on the next query.
  It also never reaches _route_request - there is one embedding slot and
  requests arrive on their own endpoints, so it is advertised under a BARE
  name rather than name@DEVICE (a RAG client looks its embedding model up
  by a string it has hard-coded; hence --embed-name).
  A RAG CLIENT SENDS ITS WHOLE CORPUS IN ONE REQUEST (LangChain does no
  batching of its own), so embed() slices it. Unsliced measured 431s and a
  peak 18.52 GB for 375 chunks against 224s and ~5 GB at 16 [OBSERVED
  2026-09-17] - faster AND lighter, so there is nothing to trade off. The
  lock is per slice so a query waits one slice, not the corpus.
  NPU IS NOT A TARGET: the plugin's embedding path requires SDPA nodes and
  refuses a plain BERT export outright - 'Check check_sdpa_nodes(model)
  failed', prepare_embedding_model.cpp:345 [OBSERVED 2026-09-17,
  all-MiniLM-L6-v2 int8, OpenVINO 2026.3.1]. CPU and GPU both work and
  agree to cosine 0.999781, so one index can be built by either."]

  ready --> _gpu_keepalive{"_gpu_keepalive<br/>dGPU ONLY, every 15s:<br/>idle &gt; --gpu-keepalive (60s)?"}
  _gpu_keepalive -->|"yes: 1-token generate,<br/>non-blocking lock"| ready
  _gpu_keepalive -.->|"iGPU / CPU / NPU:<br/>never arms"| ready
  _gpu_keepalive -.->|"the ping itself threw<br/>CL_OUT_OF_RESOURCES"| poisoned_slot

  ready --> _idle_watchdog{"_idle_watchdog<br/>every 30s, non-blocking<br/>lock acquire; status ready ONLY"}
  _idle_watchdog -.->|"idle > timeout"| unload["unload<br/>pipe=None, gc"]

  poisoned_slot["status = error<br/>_note_poisoned (stream-plumbing.mmd)<br/>after CL_OUT_OF_RESOURCES"]
  ready -.->|"GPU driver context poisoned"| poisoned_slot
  poisoned_slot -.->|"never unloaded, never reloaded;<br/>operator restarts the process"| WATCHDOGGUARD

  WATCHDOGGUARD["THE 'status != ready' SKIP IS NOT AN OPTIMISATION.
  Unloading a slot whose OpenCL context is poisoned does not fail the
  unload - it kills the process (observed 2026-09-12, Arc 140T,
  issue #38: 'Fatal Python error: Aborted', current thread
  _idle_watchdog inside unload()). _note_poisoned marks such a slot
  'error' on every generate path precisely so it never arrives here.
  Do not relax this to 'unload whatever is loaded'.
  THE KEEPALIVE IS A GENERATE PATH TOO, and the likeliest one to meet
  this unattended - a dGPU, every 60s, no client watching. It swallows
  failures by design; CL_OUT_OF_RESOURCES is the one exception, recorded
  before it is swallowed. Swallowing it silently would feed a poisoned
  slot straight to the unload above."]
  _idle_watchdog -.-> WATCHDOGGUARD
  unload -.-> ensure_loaded["ensure_loaded<br/>reload + warmup on next request,<br/>double-checked under lock"]
  ensure_loaded -.-> ready

  NOREWARM["RELOAD DOES NOT RE-WARM, deliberately: a synchronous re-warm
  would stall the triggering request pre-SSE and trip the very client
  watchdogs the heartbeat exists to defeat. Hence the flag policy:
  --prewarm implies --idle-timeout 0; combining --prewarm with a nonzero
  timeout is REFUSED at startup; --idle-timeout 0 auto-enables prewarm
  as prewarm-(port).json unless --no-prewarm."]
  ensure_loaded -.-> NOREWARM

  WRONGSLOT["PREWARM GOES TO ONE SLOT ONLY, resolved from topology in main()
  (PREWARM_SLOT): the GPU slot when it holds an LLM, else the primary. In an
  agent setup the OTHER slot serves SIDE requests - OpenCode's small_model -
  which send short titles and never the big system prompt the file holds, so
  warming it caches a prefix that can never hit AND blocks that slot's queue
  while it runs. [OBSERVED 2026-09-13, B60 dual mode] Phi-3.5-mini on CPU
  spent 233.1s prewarming the coder's 8k-token prompt; a title request that
  arrived 5s after startup was answered 157s later, queued behind it.
  Resolved in main() and NOT via _route_request, which consults
  _slot_serviceable - slots finish loading at very different times (B60: CPU
  2s, GPU 44s), so asking mid-startup returns whichever is ready first and
  re-introduces the bug.
  NOTE the names invert intuition: the big coder is `secondary` (the
  --gpu-model-dir slot); the small side model is `primary` (--device)."]
  _prewarm_slot -.-> WRONGSLOT

  DXGCAP["The trigger is the MODEL vs the DEVICE CAP, never the cap alone: a
  cap below total memory is normal (OpenCL guarantees only a quarter; a
  Xe-LPG iGPU measured 0.12 of total, an RTX 5090 exactly 0.25). Gating on
  'cap &lt; total' would fire on every iGPU NoLlama exists to serve.
  Compare the biggest single tensor instead - SmolLM3 loads under a 1 GiB
  cap because its constants are small, while Gemma 4 E2B's single 2.2 GB
  embedding table does not. That also covers the non-WSL case: a big enough
  model meets an iGPU's ~4 GB cap natively and wants the same hint."]
  _gpu_large_alloc_props -.-> DXGCAP

  RUNTIMEALLOC["WHY THERE IS A MANUAL FLAG AT ALL: the inspection above asks
  a LOAD-time question - is any stored weight bigger than the cap - and no
  amount of reading the IR answers the RUN-time one. On the plain VLM path
  the biggest buffer is a dense [1,1,S,S] attention mask built per request,
  so the true ceiling is a prompt LENGTH and it grows as the square of it.
  Reported at 4,490,608,144 bytes = 67,012 x 67,012 exactly, against a
  4,294,959,104 cap on an Arc 140T (issue #24) - a model whose weights are
  nowhere near the cap and which is fine at 60k tokens. Hence: automatic for
  weights, --gpu-large-alloc for the rest, and explain_genai_error names
  the flag when it sees the error (stream-plumbing.mmd)."]
  alloc_gate -.-> RUNTIMEALLOC

  POOLSTABLE["Pool auto-size uses the TOTAL device budget, not free RAM:
  stable across restarts/reloads. CB grows into the pool rather than
  allocating upfront, but prefix-cached blocks are never released - hence
  leaving anything back at all.
  GPU takes the larger of (headroom - AUTO_KV_RESERVE_GB) and headroom/3.
  The third alone under-spends a big budget: 25.3 GB with 15.2 GB of
  weights sized 2.87 GB, int()-truncated to 2, which looked like the floor
  when it was not - ~22k tokens against an agent declaring 60k of context,
  and a pool that cannot hold prompt + max_tokens lets ONE request evict
  its own prefix mid-generation.
  CPU KEEPS THE FRACTION ONLY. There the budget is the machine's whole RAM,
  shared with the OS, so a 2 GB reserve is not a margin - it is a claim on
  the box. It asked for 27.8 GB of a 32 GB machine and only the token cap
  stopped it (B60 + Phi-3.5-mini, 2026-09-13). A GPU budget is dedicated,
  or on an iGPU a carve-out the driver already sized against the OS.
  On CPU the budget is min(MemTotal, cgroup limit) - /proc/meminfo alone
  reports the HOST total inside a container and oversizes the pool.
  WATCH A MODEL WITHOUT GQA: Phi-3.5-mini has kv_heads == heads, 384 KB per
  token against the 30B coder's 96 KB, so the 64k cap alone is 24 GB. A
  small model is not automatically a small pool."]
  _resolve_kv_pool -.-> POOLSTABLE

  EVICTION["WINDOWS EVICTS A DISCRETE GPU'S VRAM ON IDLE, and NoLlama is not
  involved: status stays ready, the allocation is never released, committed
  memory does not change. [OBSERVED 2026-09-13, Arc Pro B60] 20.34 GB -&gt; 0 at
  80s, 80s and 79s after the last request - three for three - each time moving
  ~20.1 GB into host RAM and copying it back on the next request at ~10s TTFT
  against ~0.5s warm. NOT memory pressure: 21.5 GB of host RAM was free when
  it evicted. An iGPU is immune because its VRAM IS host RAM: same model, same
  window, 15.90 -&gt; 15.82 GB (0.5% drift) and a generate after 300s idle took
  0.1s. Hence _keepalive_eligible gates on FULL_DEVICE_NAME's (dGPU) suffix -
  pinging an iGPU would burn power for nothing."]
  _gpu_keepalive -.-> EVICTION

  npu_warn -.-> NPUARCH
  NPUARCH["SILENT ON EVERY SIGNAL A USER CAN CHECK: an LFM2 int4-cw on NPU 4
  compiles, decodes at full speed and returns fluent word salad, while the
  SAME FILES on NPU 3 are correct - two NPU drivers, three OpenVINO versions
  and both compilers held constant [OBSERVED 2026-09-01,
  openvinotoolkit/openvino#38100]. FULL_DEVICE_NAME is 'Intel(R) AI Boost' on
  every generation, so DEVICE_ARCHITECTURE ('3720' = NPU 3, '4000' = NPU 4) is
  the only discriminator. install.ps1 keeps these off the menu (models.json
  npu_arch_deny); this guard is for the copy already on disk, which never
  passed the installer. WARNS RATHER THAN REFUSES because the fault is not the
  whole family - a 2.6B on a 256V was reported working upstream."]

