%% Slot lifecycle: backend pick, load, prefix cache, prewarm, idle unload.
%% Drawn 2026-08-19 from nollama.py @ 85e796f.
%% Updated 2026-09-01: --gpu-large-alloc manual override of the alloc gate (issue #24).
%% Legend: solid = normal path, dashed = failure/fallback/degraded,
%%         ALL-CAPS nodes = prose annotations.
%% Palette: route (blue) = decisions, gen (green) = live pipeline states,
%%          client (yellow) = external effects, warn (orange) = annotations.
%% covers: nollama.py:main,needs_optimum,is_vlm,_verify_weights_integrity,_resolve_kv_pool,_preflight_memory,_largest_weight_tensor_bytes,_gpu_large_alloc_props,load,warmup,_prewarm_slot,_idle_watchdog,ensure_loaded,unload,_load_in_background
%% (_slot_class is nested inside main and invisible to the checker's AST scan
%%  — its box below is covered via main.)
flowchart TB
  main["main<br/>ports, devices, flag policy"] --> _slot_class
  _slot_class{"_slot_class<br/>--backend / NEEDS_OPTIMUM"}
  _slot_class -->|"genai (default)"| load
  _slot_class -.->|"nemotron_h or --backend optimum"| optimum_load["OptimumSlot.load<br/>python runtime, no prefix cache,<br/>text-only even for VLM-shaped exports"]

  main --> _load_in_background["_load_in_background<br/>one thread per slot; prints the ready
  banner once when ALL slots settled"]
  _load_in_background --> load

  load["DeviceSlot.load"] --> _verify_weights_integrity
  _verify_weights_integrity{"_verify_weights_integrity<br/>max(offset+size) per IR vs .bin bytes"}
  _verify_weights_integrity -.->|"truncated / missing .bin"| loaderr["RuntimeError, plain-English;<br/>'another process using the NPU?'<br/>hint SUPPRESSED for this class"]
  _verify_weights_integrity --> _resolve_kv_pool

  _resolve_kv_pool["_resolve_kv_pool<br/>pin via --cache-size-gb, else auto:<br/>(budget - weights*1.1)/3, floor 2 GB,<br/>cap 64k tokens of KV geometry"]
  _resolve_kv_pool --> _preflight_memory["_preflight_memory<br/>WARNS, never blocks; logs pool
  token capacity"]
  _preflight_memory --> alloc_gate

  alloc_gate{"GPU slot:<br/>--gpu-large-alloc given?"}
  alloc_gate -.->|"yes: force the property,<br/>skip the inspection entirely"| pipebuild
  alloc_gate -->|"no (the default)"| _gpu_large_alloc_props

  _gpu_large_alloc_props{"_gpu_large_alloc_props<br/>GPU only: _largest_weight_tensor_bytes<br/>&gt; this device's per-alloc cap?"}
  _gpu_large_alloc_props -.->|"yes: add<br/>GPU_ENABLE_LARGE_ALLOCATIONS"| pipebuild
  _gpu_large_alloc_props -->|"no (the common case)"| pipebuild

  pipebuild{"pipeline build<br/>plugin_props = OFFLOAD_RATIO +<br/>large-allocation hint"}
  pipebuild -->|NPU| npu_pipe["LLMPipeline MAX_PROMPT_LEN=4096<br/>plain; no CB path on NPU"]
  pipebuild -->|"GPU/CPU + prompt cache"| cb_pipe["LLMPipeline / VLMPipeline with<br/>scheduler_config(enable_prefix_caching,<br/>cache_size=kv_pool_gb)"]
  pipebuild -->|--no-prompt-cache| plain_pipe["plain pipeline"]
  cb_pipe -.->|"runtime rejects the property"| cb_fallback["plain pipeline; kv_pool_gb=0<br/>so /health is honest and<br/>prewarm skips this slot"]

  cb_pipe --> warmup["warmup<br/>5-token generate; ready or error"]
  npu_pipe --> warmup
  plain_pipe --> warmup
  cb_fallback --> warmup
  optimum_load --> warmup

  warmup --> _prewarm_slot{"_prewarm_slot<br/>PREWARM_FILE + live kv pool?"}
  _prewarm_slot -->|"yes: prefill saved prompt<br/>(VLM replays via parse_messages<br/>so the token prefix matches)"| ready["ready<br/>(first real turn = cache hit)"]
  _prewarm_slot -.->|"no pool / no file"| ready

  ready --> _idle_watchdog{"_idle_watchdog<br/>every 30s, non-blocking<br/>lock acquire"}
  _idle_watchdog -.->|"idle > timeout"| unload["unload<br/>pipe=None, gc"]
  unload -.-> ensure_loaded["ensure_loaded<br/>reload + warmup on next request,<br/>double-checked under lock"]
  ensure_loaded -.-> ready

  NOREWARM["RELOAD DOES NOT RE-WARM, deliberately: a synchronous re-warm
  would stall the triggering request pre-SSE and trip the very client
  watchdogs the heartbeat exists to defeat. Hence the flag policy:
  --prewarm implies --idle-timeout 0; combining --prewarm with a nonzero
  timeout is REFUSED at startup; --idle-timeout 0 auto-enables prewarm
  as prewarm-(port).json unless --no-prewarm."]
  ensure_loaded -.-> NOREWARM

  DXGCAP["The trigger is the MODEL vs the DEVICE CAP, never the cap alone: a
  cap below total memory is normal (OpenCL guarantees only a quarter; a
  Xe-LPG iGPU measured 0.12 of total, an RTX 5090 exactly 0.25). Gating on
  'cap &lt; total' would fire on every iGPU NoLlama exists to serve.
  Compare the biggest single tensor instead - SmolLM3 loads under a 1 GiB
  cap because its constants are small, while Gemma 4 E2B's single 2.2 GB
  embedding table does not. That also covers the non-WSL case: a big enough
  model meets an iGPU's ~4 GB cap natively and wants the same hint."]
  _gpu_large_alloc_props -.-> DXGCAP

  RUNTIMEALLOC["WHY THERE IS A MANUAL FLAG AT ALL: the inspection above asks
  a LOAD-time question - is any stored weight bigger than the cap - and no
  amount of reading the IR answers the RUN-time one. On the plain VLM path
  the biggest buffer is a dense [1,1,S,S] attention mask built per request,
  so the true ceiling is a prompt LENGTH and it grows as the square of it.
  Reported at 4,490,608,144 bytes = 67,012 x 67,012 exactly, against a
  4,294,959,104 cap on an Arc 140T (issue #24) - a model whose weights are
  nowhere near the cap and which is fine at 60k tokens. Hence: automatic for
  weights, --gpu-large-alloc for the rest, and explain_genai_error names
  the flag when it sees the error (stream-plumbing.mmd)."]
  alloc_gate -.-> RUNTIMEALLOC

  POOLSTABLE["Pool auto-size uses the TOTAL device budget, not free RAM:
  stable across restarts/reloads. CB grows into the pool rather than
  allocating upfront, but prefix-cached blocks are never released -
  hence taking only a third of headroom (AUTO_KV_HEADROOM_SHARE).
  On CPU the budget is min(MemTotal, cgroup limit) - /proc/meminfo alone
  reports the HOST total inside a container and oversizes the pool."]
  _resolve_kv_pool -.-> POOLSTABLE

