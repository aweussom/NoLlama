%% covers: nollama.py:chat_completions,ollama_chat,ollama_generate,ollama_v1_chat_completions,parse_messages,_route_request,_tools_supported,prepare_messages_for_tools,_maybe_capture_prewarm,_sse_tool_stream,_assistant_message,parse_tool_calls,render_native_tool_prompt,_load_native_template
flowchart TB
  openai_client["OpenAI client<br/>POST /v1/chat/completions<br/>(port 8000 or 11434)"]
  ollama_client["Ollama client<br/>POST /api/chat | /api/generate"]

  chat_completions["chat_completions"]
  ollama_v1_chat_completions["ollama_v1_chat_completions<br/>(delegates verbatim)"]
  ollama_chat["ollama_chat<br/>translates images[] to image_url blocks,<br/>options.num_predict/temperature"]
  ollama_generate["ollama_generate<br/>single turn, no history"]

  parse_messages["parse_messages<br/>flatten roles, strip leading think from<br/>assistant history, load+anchor images"]
  _route_request{"_route_request"}
  _tools_supported{"_tools_supported<br/>device in GPU,CPU?"}
  prepare_messages_for_tools["prepare_messages_for_tools<br/>tool specs into system prompt,<br/>history tool_calls back to XML,<br/>tool results as tagged user turns"]
  _maybe_capture_prewarm["_maybe_capture_prewarm<br/>save big agent prompt for next startup"]

  stream_llm["stream_llm<br/>SSE tokens + keepalive"]
  stream_vlm["stream_vlm<br/>SSE tokens (VLM)"]
  _sse_tool_stream["_sse_tool_stream<br/>token-streamed: reasoning_content live,<br/>content live until _ToolCallGate sees an<br/>opener; the held text goes to parse_tool_calls.<br/>Nothing held and the turn ended inside an<br/>unclosed think: that block is parsed instead,<br/>or sent as the answer if it holds no call"]
  generate_blocking["generate_llm / generate_vlm<br/>blocking JSON reply via _assistant_message<br/>(think span -> reasoning_content)"]
  parse_tool_calls["parse_tool_calls<br/>Qwen3 XML, Hermes, ATEM, bare function=,<br/>Mistral, Llama, DeepSeek, bare-JSON fallback"]

  openai_client --> chat_completions
  ollama_client --> ollama_chat
  ollama_client --> ollama_generate
  openai_client --> ollama_v1_chat_completions --> chat_completions

  chat_completions --> parse_messages --> _route_request
  ollama_chat --> parse_messages
  ollama_generate --> _route_request

  _route_request -->|"explicit model@DEVICE match"| _tools_supported
  _route_request -->|"images: VLM slot; text: LLM-bearing<br/>secondary else primary"| _tools_supported
  _route_request -.->|"images but no VLM loaded"| refuse400["400 no vision model"]
  _route_request -.->|"nothing serviceable"| refuse503["503 not ready"]

  _tools_supported -->|"tools + GPU/CPU"| prepare_messages_for_tools
  _tools_supported -.->|"tools + NPU: tools IGNORED,<br/>answered as plain chat"| pathpick
  _tools_supported -->|no tools| pathpick

  prepare_messages_for_tools --> pathpick
  prepare_messages_for_tools -->|"--tool-template native,<br/>genai LLM slot"| render_native_tool_prompt
  render_native_tool_prompt["render_native_tool_prompt<br/>the model's own chat_template.jinja via<br/>_load_native_template (sandboxed jinja2):<br/>its tool list, its call syntax, its tool role.<br/>native_prompt rides to the LLM seam,<br/>generated with the pipeline template off"]
  render_native_tool_prompt -->|native_prompt| pathpick
  render_native_tool_prompt -.->|"no template / render raised:<br/>None, the Qwen-XML render stands"| pathpick
  pathpick{"model_type x stream x tools"}
  pathpick --> _maybe_capture_prewarm

  _maybe_capture_prewarm -->|"stream, no tools, LLM"| stream_llm
  _maybe_capture_prewarm -->|"stream, no tools, VLM"| stream_vlm
  _maybe_capture_prewarm -->|"stream + tools (LLM or VLM)"| _sse_tool_stream
  _maybe_capture_prewarm -->|non-stream| generate_blocking

  _maybe_capture_prewarm -->|"VLM + no-think marker in a<br/>SYSTEM message, text-only"| render_nothink_prompt
  render_nothink_prompt["render_nothink_prompt<br/>tokenizer.apply_chat_template(raw_messages,<br/>enable_thinking=false) replaces the flattened<br/>text_prompt; raw_prompt=True rides along so the<br/>VLM seam skips its own template and the splitter<br/>starts OUTSIDE a think block (preseeded_for).<br/>LLM slots do this inside the seam instead"]
  render_nothink_prompt --> stream_vlm
  render_nothink_prompt --> _sse_tool_stream
  render_nothink_prompt --> generate_blocking

  _sse_tool_stream --> parse_tool_calls
  generate_blocking -->|tools active| parse_tool_calls

  GATED["TOOL TURNS STREAM (2026-08-30, issue #36): reasoning and answer
  text go out token by token; only the tool-call block is held, because
  a structured tool_calls delta needs it parsed whole. Agent clients
  send tools on EVERY request, so the old whole-turn buffering meant
  they never saw a live token. Keep-alive pings every HEARTBEAT_SECS
  still cover a minutes-long prefill (Copilot aborts ~120s) -
  and an aborted client leaves OpenVINO churning: prefill cannot be
  cancelled. The Ollama surface keeps its buffered tool turn."]
  _sse_tool_stream -.-> GATED

  NPUGATE["NPU never gets tools: hard MAX_PROMPT_LEN cap and NPU-class
  models cannot drive agent loops. /api/show advertises the tools
  capability only for GPU/CPU slots so Copilot will not offer NPU
  models for agent mode."]
  _tools_supported -.-> NPUGATE

