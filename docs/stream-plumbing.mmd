%% Token streaming: the stream_tokens seam, its consumers, cancel semantics.
%% Drawn 2026-08-19 from nollama.py @ 85e796f.
%% Updated 2026-08-30: stream_vlm_tokens seam, shared _sse_stream, _ThinkSplitter/_ToolCallGate (issue #36).
%% Updated 2026-09-01: _vlm_penalty_guard one-shot retry on the image path.
%% Legend: solid = normal path, dashed = failure/timeout/cancel paths,
%%         ALL-CAPS nodes = prose annotations.
%% Palette: route (blue) = protocol consumers, gen (green) = backend/worker,
%%          client (yellow) = wire frames, warn (orange) = annotations.
%% covers: nollama.py:stream_tokens,stream_vlm_tokens,_vlm_penalty_guard,_is_placeholder_bounds_error,stream_llm,stream_vlm,_sse_stream,_ollama_stream_chat,_ollama_stream_generate,generate_llm,cancel,explain_genai_error,_AtemStreamFilter,_AtemPlainFilter,_ThinkSplitter,_split_think,_ToolCallGate,_prompt_preseeds_think
flowchart TB
  stream_tokens["DeviceSlot.stream_tokens<br/>SEAM between backend and protocol.<br/>Owns: worker thread, lock, clearing<br/>_cancel INSIDE the lock, _stream_error.<br/>Yields str chunk, or None after
  'heartbeat' quiet seconds"]
  worker["worker thread:<br/>pipe.generate(history, gen, streamer_callback)<br/>tokens -> Queue; sentinel None in finally"]
  opt_stream_tokens["OptimumSlot.stream_tokens<br/>same contract over transformers<br/>TextIteratorStreamer; ATEM markers kept<br/>visible for _AtemStreamFilter"]
  stream_vlm_tokens["DeviceSlot.stream_vlm_tokens<br/>VLM twin of the seam: VLMPipeline takes<br/>prompt+images, not ChatHistory; runs<br/>_AtemPlainFilter before yielding; same<br/>None heartbeats (the old 180s silent<br/>abort in stream_vlm is gone)"]

  stream_tokens --> worker
  stream_vlm_tokens --> worker

  penalty_guard["_vlm_penalty_guard (image turns only)<br/>Some VLM exports put image placeholders<br/>outside 0..vocab_size. genai's repetition<br/>-penalty transformer walks the PROMPT ids<br/>and asserts on them, so every image turn died<br/>while text turns worked. First failure sets a<br/>per-slot flag, warns once, and retries with<br/>repetition_penalty = 1.0; later image turns<br/>skip the penalty up front. Text turns keep it"]
  worker -.->|"image turn asserts:<br/>prompt_id out of bounds"| penalty_guard
  penalty_guard -.->|"retry once, penalty cleared"| worker

  RETRYSAFE["THE RETRY IS SAFE TO REPLAY: the assertion fires in the sampler
  BEFORE any token reaches streamer_callback, so the consumer has seen
  nothing to un-send. That is what makes one-shot retry viable on a
  streaming seam at all. Cost is one re-prefill, once per load.
  Observed on Arc 140T, 140V and Arc Pro B60, genai 2026.3 and 2026.5."]
  penalty_guard -.-> RETRYSAFE
  worker -.->|"backend exception"| _stream_error["_stream_error set;<br/>explain_genai_error names the fix<br/>(KV pool too small, NPU compiler,<br/>AUTO_DETECT -> --npu-platform, ...).<br/>Order matters: the specific matchers run<br/>before the broad 'Compilation failed' one,<br/>and the NPU hints are gated on the slot's<br/>device — see tests/test_npu_pin.py"]

  _sse_stream["_sse_stream (OpenAI SSE, shared body)<br/>None -> empty-content delta keepalive;<br/>first token stamps wall-clock TTFT;<br/>finish stop / cancelled / error, [DONE]"]
  stream_llm["stream_llm / stream_vlm<br/>thin wrappers: pick the seam,<br/>delegate to _sse_stream"]
  tool_stream["_sse_tool_stream (request-flow.mmd)<br/>same frames, plus _ToolCallGate<br/>and tool_calls deltas at the end"]
  _ollama_stream_chat["_ollama_stream_chat (ndjson)<br/>None after 120s ABORTS<br/>(historical no-token timeout);<br/>think stays inside content"]
  _ollama_stream_generate["_ollama_stream_generate (ndjson)<br/>same abort; no TTFT"]
  generate_llm["generate_llm (OptimumSlot)<br/>non-streaming = joined stream,<br/>heartbeat=None blocks forever"]

  stream_tokens --> _sse_stream
  stream_vlm_tokens --> _sse_stream
  _sse_stream --> stream_llm
  stream_tokens --> tool_stream
  stream_vlm_tokens --> tool_stream
  stream_tokens --> _ollama_stream_chat
  stream_tokens --> _ollama_stream_generate
  opt_stream_tokens --> generate_llm

  splitter["_ThinkSplitter / _split_think<br/>think spans -> reasoning_content deltas,<br/>answer -> content; tag prefixes held back<br/>across chunk boundaries; empty block dropped.<br/>_prompt_preseeds_think (at load, via the<br/>pipeline's own tokenizer) starts it inside a<br/>block for templates that open think themselves.<br/>--think-in-content restores the old shape"]
  gate["_ToolCallGate<br/>content streams until a tool-call opener<br/>(any syntax parse_tool_calls knows);<br/>held from there, parsed at the end"]
  _sse_stream --> splitter
  tool_stream --> splitter
  tool_stream --> gate

  atem["_AtemStreamFilter / _AtemPlainFilter<br/>Glimmer channel routing -> think tags.<br/>StreamFilter keys on live markers<br/>(optimum path keeps special tokens);<br/>PlainFilter keys on detokenized<br/>'to=self' / 'assistant to=user' text<br/>(GenAI strips the markers)"]
  stream_vlm_tokens --> atem
  opt_stream_tokens --> atem
  atem --> splitter

  cancel["cancel / client disconnect<br/>_cancel.set() -> streamer_callback<br/>returns True -> generation stops"]
  _sse_stream -.-> cancel
  tool_stream -.-> cancel

  FINALLY["THE CANCEL SAFETY NET LIVES IN THE CONSUMERS, NOT THE SEAM:
  each consumer's finally does _cancel.set() so a client disconnect
  stops generation. It cannot move into stream_tokens - a generator's
  finally also runs on normal exhaustion, which would make the
  consumer's was_cancelled = _cancel.is_set() read True on every
  completed stream. Mirror rule: _cancel is CLEARED inside the lock in
  the worker, else it races the previous request's finally."]
  cancel -.-> FINALLY

  CANCELLIMIT["Cancel relies on OpenVINO invoking the streamer callback.
  A blocked prefill never yields, so cancel cannot take effect until
  prefill ends - an aborted client leaves the generation churning.
  This is why keepalive (not abort-and-retry) is the strategy for
  slow prefills."]
  cancel -.-> CANCELLIMIT

  ORDER["FILTER ORDER IS FIXED: ATEM (channel markers -> think tags)
  runs inside the VLM/optimum seams, the splitter keys on the tags it
  produces, and the gate only ever sees answer text - tool openers
  inside a think span are reasoning, not calls."]
  splitter -.-> ORDER

